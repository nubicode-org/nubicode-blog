---
import { existsSync, readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import Base from "../layouts/Base.astro";
import { published, readingMinutes, formatDate } from "../lib/posts.js";
const posts = await published();
const fmt = (d) => formatDate(d, "short");
// Card thumbnail = the post's diagram (scripts/render-images.mjs writes diagram-thumb.png). Not the cover:
// the cover repeats the title that sits right next to it.
// ?v=<content hash>: images are cached by browsers (1 day) and the service worker, so a re-rendered
// thumbnail at the same path would otherwise show stale; a new hash is a new URL.
const thumb = (id) => {
  const file = `public/images/${id}/diagram-thumb.png`;
  if (!existsSync(file)) return null;
  const v = createHash("sha256").update(readFileSync(file)).digest("hex").slice(0, 10);
  return `/images/${id}/diagram-thumb.png?v=${v}`;
};

// Topic filter: tags shared by 2+ posts are always visible; one-off tags sit behind "+N more".
const counts = new Map();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const byCount = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const primary = byCount.filter(([, n]) => n > 1);
const extra = byCount.filter(([, n]) => n === 1);

const jsonld = [{
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "NubiCode Blog",
  url: "https://blog.nubicode.com/",
  description: "Engineering notes on Kubernetes, GitOps, FinOps, cloud migrations and AI infrastructure from NubiCode's nearshore team.",
  publisher: { "@id": "https://www.nubicode.com/#organization" },
  inLanguage: "en-US",
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: `https://blog.nubicode.com/${p.id}`,
    datePublished: p.data.pubDate.toISOString(),
    ...(p.data.image && { image: `https://blog.nubicode.com${p.data.image}` }),
    author: { "@type": "Person", name: p.data.author },
  })),
}];
---
<Base wide title="NubiCode Blog — cloud-native, Kubernetes & AI infrastructure notes" description="Engineering notes on Kubernetes, GitOps, FinOps, cloud migrations and AI infrastructure from NubiCode's nearshore team in El Salvador and Baltimore." canonical="https://blog.nubicode.com/" jsonld={jsonld}>
  <h1 class="section-title">Nearshore Platform Notes</h1>
  <p class="section-subtitle">How we build and run cloud-native platforms and AI infrastructure for US teams. Real numbers, real configs, anonymized clients.</p>

  <div class="filters" role="toolbar" aria-label="Filter posts by topic" id="filters">
    <button type="button" class="filter-chip" data-tag="" aria-pressed="true">All <span class="count">{posts.length}</span></button>
    {primary.map(([t, n]) => <button type="button" class="filter-chip" data-tag={t} aria-pressed="false">{t} <span class="count">{n}</span></button>)}
    {extra.map(([t, n]) => <button type="button" class="filter-chip is-extra" data-tag={t} aria-pressed="false">{t} <span class="count">{n}</span></button>)}
    {extra.length > 0 && <button type="button" class="filter-more" aria-expanded="false" aria-controls="filters">+{extra.length} more</button>}
  </div>
  <p class="filter-status" aria-live="polite"></p>

  <div class="post-grid">
    {posts.map((p, i) => (
      <article class="card glass" data-tags={p.data.tags.join(" ")}>
        {thumb(p.id) && (
          <img class="card-thumb skeleton" src={thumb(p.id)} alt="" width="1200" height="600"
            loading={i < 3 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" />
        )}
        <div class="card-body">
          <h2 class="card-title"><a class="card-link" href={`/${p.id}`}>{p.data.title}</a></h2>
          <div class="meta"><time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{fmt(p.data.pubDate)}</time> · {readingMinutes(p.body)} min read</div>
          <p class="card-desc">{p.data.description}</p>
          <div class="tags">
            {p.data.tags.map((t) => <button type="button" class="tag" data-tag={t} aria-label={`Show posts tagged ${t}`}>{t}</button>)}
          </div>
        </div>
      </article>
    ))}
  </div>

  <script>
    const filters = document.getElementById("filters")!;
    const status = document.querySelector<HTMLElement>(".filter-status")!;
    const cards = [...document.querySelectorAll<HTMLElement>(".post-grid .card")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    function render(tag: string) {
      let shown = 0;
      for (const card of cards) {
        const match = !tag || (card.dataset.tags ?? "").split(" ").includes(tag);
        card.hidden = !match;
        if (match) shown++;
        card.querySelectorAll<HTMLElement>(".tag").forEach((b) => b.classList.toggle("is-active", b.dataset.tag === tag));
      }
      filters.querySelectorAll<HTMLButtonElement>(".filter-chip").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tag === tag)));
      const active = filters.querySelector<HTMLElement>(`.filter-chip[data-tag="${CSS.escape(tag)}"]`);
      if (active?.classList.contains("is-extra")) expand(true);
      status.textContent = tag ? `${shown} ${shown === 1 ? "post" : "posts"} tagged “${tag}”` : "";
    }

    function apply(tag: string) {
      const url = new URL(location.href);
      tag ? url.searchParams.set("tag", tag) : url.searchParams.delete("tag");
      history.replaceState(null, "", url);
      // Animate the reflow where supported (same-document View Transition); instant otherwise.
      if (document.startViewTransition && !reduce.matches) document.startViewTransition(() => render(tag));
      else render(tag);
    }

    const more = filters.querySelector<HTMLButtonElement>(".filter-more");
    const moreLabel = more?.textContent ?? "";
    function expand(open: boolean) {
      filters.classList.toggle("is-expanded", open);
      if (more) { more.setAttribute("aria-expanded", String(open)); more.textContent = open ? "Fewer" : moreLabel; }
    }
    more?.addEventListener("click", () => expand(!filters.classList.contains("is-expanded")));

    filters.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-chip");
      if (chip) apply(chip.getAttribute("aria-pressed") === "true" ? "" : chip.dataset.tag ?? "");
    });

    // Tags on a card filter too (and toggle off when already active).
    document.querySelector(".post-grid")!.addEventListener("click", (e) => {
      const tagBtn = (e.target as HTMLElement).closest<HTMLButtonElement>(".tag");
      if (!tagBtn) return;
      const tag = tagBtn.classList.contains("is-active") ? "" : tagBtn.dataset.tag ?? "";
      apply(tag);
      if (filters.getBoundingClientRect().top < 0) filters.scrollIntoView({ behavior: reduce.matches ? "auto" : "smooth", block: "start" });
    });

    const initial = new URL(location.href).searchParams.get("tag") ?? "";
    render(cards.some((c) => (c.dataset.tags ?? "").split(" ").includes(initial)) ? initial : "");
  </script>
</Base>
