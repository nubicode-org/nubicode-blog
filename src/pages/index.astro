---
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import { published, readingMinutes, formatDate } from "../lib/posts.js";
const posts = await published();
const fmt = (d) => formatDate(d, "short");
// Card thumbnail = the post's diagram (scripts/render-images.mjs writes diagram-thumb.png). Not the cover:
// the cover repeats the title that sits right next to it.
const thumb = (id) => (existsSync(`public/images/${id}/diagram-thumb.png`) ? `/images/${id}/diagram-thumb.png` : null);
const jsonld = [{
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "NubiCode Blog",
  url: "https://blog.nubicode.com/",
  description: "Engineering notes on Kubernetes, GitOps, FinOps, cloud migrations and AI infrastructure from NubiCode's nearshore team.",
  publisher: { "@id": "https://www.nubicode.com/#organization" },
}];
---
<Base title="NubiCode Blog — cloud-native, Kubernetes & AI infrastructure notes" description="Engineering notes on Kubernetes, GitOps, FinOps, cloud migrations and AI infrastructure from NubiCode's nearshore team in El Salvador and Baltimore." canonical="https://blog.nubicode.com/" jsonld={jsonld}>
  <h1 class="section-title">Nearshore Platform Notes</h1>
  <p class="section-subtitle">How we build and run cloud-native platforms and AI infrastructure for US teams. Real numbers, real configs, anonymized clients.</p>
  <div class="post-list">
    {posts.map((p, i) => (
      <a class:list={["card glass", { "has-thumb": thumb(p.id) }]} href={`/${p.id}`}>
        {thumb(p.id) && (
          <img class="card-thumb skeleton" src={thumb(p.id)} alt="" width="840" height="420"
            loading={i < 2 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" />
        )}
        <div>
          <h3>{p.data.title}</h3>
          <div class="meta"><time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{fmt(p.data.pubDate)}</time> · {readingMinutes(p.body)} min read · {p.data.author}</div>
          <p>{p.data.description}</p>
          <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
      </a>
    ))}
  </div>
</Base>
