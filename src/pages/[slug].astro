---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { published, readingMinutes, formatDate } from "../lib/posts.js";
export async function getStaticPaths() {
  const posts = await published(); // newest first
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const url = `https://blog.nubicode.com/${post.id}`;
const fmt = (d) => formatDate(d);
const minutes = readingMinutes(post.body);
const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  x: `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(post.data.title)}`,
};
const image = post.data.image ? `https://blog.nubicode.com${post.data.image}` : "https://www.nubicode.com/logos/og-image.png";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: post.data.title,
    description: post.data.description,
    image,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { "@type": "Person", name: post.data.author, url: post.data.authorUrl, worksFor: { "@id": "https://www.nubicode.com/#organization" } },
    publisher: { "@id": "https://www.nubicode.com/#organization" },
    mainEntityOfPage: url,
    keywords: post.data.tags.join(", "),
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "NubiCode", item: "https://www.nubicode.com/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: "https://blog.nubicode.com/" },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base title={`${post.data.title} — NubiCode Blog`} description={post.data.description} canonical={url} image={image} imageAlt={post.data.imageAlt} imageSize={post.data.image ? [1200, 627] : undefined} type="article" jsonld={jsonld}>
  <div class="progress" aria-hidden="true"></div>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <a href={post.data.authorUrl} rel="author" data-astro-prefetch="false">{post.data.author}</a> · <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt(post.data.pubDate)}</time>{post.data.updatedDate && ` · updated ${fmt(post.data.updatedDate)}`} · {minutes} min read
    </p>
    <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
    <div class="tldr glass"><strong>TL;DR</strong>{post.data.tldr}</div>
    <Content />
    <div class="share" aria-label="Share this post">
      <span class="share-label">Share</span>
      <a class="chip-btn" href={share.linkedin} target="_blank" rel="noopener" data-tooltip="Share on LinkedIn" aria-label="Share on LinkedIn">LinkedIn</a>
      <a class="chip-btn" href={share.x} target="_blank" rel="noopener" data-tooltip="Post on X" aria-label="Post on X">X</a>
      <button class="chip-btn" type="button" data-copy-link data-tooltip="Copy link" aria-label="Copy link to this post">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/></svg>Copy link
      </button>
    </div>
    <div class="cta glass">
      <p><strong>We do this for US teams.</strong>Senior nearshore engineers, US hours, AWS Partner, Vanta Partner.</p>
      <a class="btn-primary" href={`https://www.nubicode.com/?utm_source=blog&utm_medium=post&utm_campaign=${post.id}#contact`}>Book a 30-minute architecture review</a>
    </div>
    {(older || newer) && (
      <nav class="post-nav" aria-label="More posts">
        {older ? <a class="post-nav-link glass" href={`/${older.id}`} rel="prev"><span>← Previous</span><strong>{older.data.title}</strong></a> : <span />}
        {newer && <a class="post-nav-link glass next" href={`/${newer.id}`} rel="next"><span>Next →</span><strong>{newer.data.title}</strong></a>}
      </nav>
    )}
  </article>
  <script>
    const COPY = '<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const DONE = '<svg class="icon-done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

    // Show a tooltip briefly (works on touch, where there is no hover), then restore it.
    function flash(el: HTMLElement, text: string, ok: boolean) {
      const original = el.dataset.tooltipOriginal ?? el.dataset.tooltip ?? "";
      el.dataset.tooltipOriginal = original;
      el.dataset.tooltip = text;
      el.classList.add("is-flashing");
      el.classList.toggle("is-done", ok);
      clearTimeout(Number(el.dataset.timer));
      el.dataset.timer = String(setTimeout(() => {
        el.dataset.tooltip = original;
        el.classList.remove("is-flashing", "is-done");
      }, 1600));
    }
    // Clipboard API first; the hidden-textarea path covers browsers/embeds that block it.
    function legacyCopy(text: string) {
      const ta = Object.assign(document.createElement("textarea"), { value: text, readOnly: true });
      ta.style.cssText = "position:fixed;opacity:0;pointer-events:none";
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand("copy");
      ta.remove();
      return ok;
    }
    async function copy(text: string, el: HTMLElement, done: string) {
      let ok = false;
      try { await navigator.clipboard.writeText(text); ok = true; }
      catch { ok = legacyCopy(text); }
      flash(el, ok ? done : "Press ⌘C / Ctrl+C to copy", ok);
    }

    // Copy buttons on code blocks.
    document.querySelectorAll<HTMLPreElement>("article pre").forEach((pre) => {
      const wrap = document.createElement("div");
      wrap.className = "code-block";
      pre.replaceWith(wrap);
      wrap.append(pre);
      const lang = pre.dataset.language;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "copy-btn";
      btn.dataset.tooltip = "Copy code";
      btn.dataset.tooltipPos = "left";
      btn.setAttribute("aria-label", lang && lang !== "plaintext" ? `Copy ${lang} code` : "Copy code");
      btn.innerHTML = COPY + DONE;
      btn.addEventListener("click", () => copy(pre.innerText.replace(/\n$/, ""), btn, "Copied"));
      wrap.append(btn);
    });

    // "#" links on section headings: click copies a deep link to that section.
    document.querySelectorAll<HTMLHeadingElement>("article h2[id], article h3[id]").forEach((h) => {
      const a = document.createElement("a");
      a.className = "anchor";
      a.href = `#${h.id}`;
      a.textContent = "#";
      a.dataset.tooltip = "Copy link to section";
      a.setAttribute("aria-label", `Copy link to section: ${h.textContent}`);
      a.addEventListener("click", (e) => {
        e.preventDefault();
        history.replaceState(null, "", a.href);
        h.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        copy(location.href, a, "Link copied");
      });
      h.append(a);
    });

    document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", (e) =>
      copy(location.href.split("#")[0], e.currentTarget as HTMLElement, "Link copied"));
  </script>
</Base>
