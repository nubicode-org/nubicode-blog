---
import "../styles/global.css";
const {
  title,
  description,
  canonical = Astro.url.href,
  image = "https://www.nubicode.com/logos/og-image.png",
  wide = false, // index grid gets a wider column than the 800px reading measure
  imageAlt,
  imageSize,
  type = "website",
  jsonld = [],
} = Astro.props;
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.nubicode.com/#organization",
  name: "NubiCode",
  url: "https://www.nubicode.com/",
  logo: "https://www.nubicode.com/logos/apple-touch-icon.png",
  description: "Nearshore cloud-native and AI infrastructure engineering. AWS Partner, Vanta Partner. Baltimore, MD and San Salvador, El Salvador.",
  sameAs: [
    "https://www.linkedin.com/company/NubiCode-org/",
    "https://github.com/nubicode-org",
    "https://x.com/nubicode",
    "https://www.instagram.com/nubicode",
    "https://www.facebook.com/nubicode",
  ],
  areaServed: "US",
  address: [
    { "@type": "PostalAddress", addressLocality: "Baltimore", addressRegion: "MD", addressCountry: "US" },
    { "@type": "PostalAddress", addressLocality: "San Salvador", addressCountry: "SV" },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="NubiCode Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {image.endsWith(".png") && <meta property="og:image:type" content="image/png" />}
    {imageSize && <meta property="og:image:width" content={String(imageSize[0])} />}
    {imageSize && <meta property="og:image:height" content={String(imageSize[1])} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nubicode" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="48x48" href="/logos/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logos/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logos/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="NubiCode Blog" href="/rss.xml" />
    <meta name="theme-color" content="#4768F2" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="navbar" id="navbar" aria-label="Main navigation">
      <div class="nav-container">
        <a href="https://www.nubicode.com/?utm_source=blog&utm_medium=nav" class="nav-logo" aria-label="NubiCode home">
          <img src="/logos/NubiCode responsive-03.png" alt="NubiCode" width="150" height="40" />
        </a>
        <div class="nav-menu">
          <a href="/" class="nav-link">Blog</a>
          <a href="https://www.nubicode.com/#services" class="nav-link hide-sm">Services</a>
          <a href="/rss.xml" class="nav-link hide-sm" data-tooltip="Subscribe via RSS" data-tooltip-pos="bottom" aria-label="RSS feed — subscribe via RSS" data-astro-prefetch="false">RSS</a>
          <a href="https://www.nubicode.com/?utm_source=blog&utm_medium=nav#contact" class="btn btn-glass nav-cta">Get Started</a>
        </div>
      </div>
    </nav>
    <main id="main" class:list={[{ wide }]}><slot /></main>
    <footer class="footer">
      <div class="footer-container">
        <div>
          <img class="footer-logo" src="/logos/NubiCode responsive-03.png" alt="NubiCode" width="150" height="50" loading="lazy" />
          <p>Nearshore cloud-native &amp; AI infrastructure engineering for US teams. AWS Partner · Vanta Partner.</p>
          <p>Baltimore, Maryland · San Salvador, El Salvador</p>
        </div>
        <div>
          <h3>Company</h3>
          <ul>
            <li><a href="https://www.nubicode.com/#services">Services</a></li>
            <li><a href="https://www.nubicode.com/#gallery">Our Work</a></li>
            <li><a href="https://www.nubicode.com/#contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3>Follow</h3>
          <ul>
            <li><a href="https://www.linkedin.com/company/NubiCode-org/">LinkedIn</a></li>
            <li><a href="https://github.com/nubicode-org">GitHub</a></li>
            <li><a href="https://x.com/nubicode">X</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom"><span>© 2026 NubiCode. All rights reserved.</span><span>info@nubicode.com</span></div>
    </footer>
    <script>
      // Skeleton → loaded: stop the shimmer once each image has decoded (or failed).
      const settle = (img: HTMLImageElement) => img.classList.add("is-loaded");
      document.querySelectorAll<HTMLImageElement>("img.skeleton, figure.diagram img").forEach((img) => {
        if (img.complete) settle(img);
        else { img.addEventListener("load", () => settle(img), { once: true }); img.addEventListener("error", () => settle(img), { once: true }); }
      });
      // Nav: transparent at the top, glass once the page scrolls (DESIGN.md).
      const navbar = document.getElementById("navbar");
      const updateNav = () => navbar?.classList.toggle("scrolled", scrollY > 24);
      updateNav();
      addEventListener("scroll", updateNav, { passive: true });
      if ("serviceWorker" in navigator && location.hostname !== "localhost") {
        addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
      }
    </script>
  </body>
</html>
